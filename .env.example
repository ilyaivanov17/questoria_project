# Local development. Root scripts load this file for both workspace apps.
DATABASE_URL="postgresql://questoria:questoria_local_only@localhost:5432/questoria?schema=public"
API_PORT=4000
API_INTERNAL_URL="http://localhost:4000"

# Leave empty to auto-detect the frontend origin in GitHub Codespaces.
# Outside Codespaces, the API defaults to http://localhost:3000.
WEB_ORIGIN=
NEXT_PUBLIC_SITE_URL=

# Email: console prints one-time links to the API terminal in local development.
# Production must use a verified sender with Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Required only to set up TOTP MFA for administrator accounts (32-byte hex key).
MFA_ENCRYPTION_KEY=
