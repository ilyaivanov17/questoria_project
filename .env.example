# Local development. Root scripts load this file for both workspace apps.
# Production API startup validates the required settings; see docs/operations/production-environment.md.
DATABASE_URL="postgresql://questoria:questoria_local_only@localhost:5432/questoria?schema=public"
API_PORT=4000
API_INTERNAL_URL="http://localhost:4000"

# Local only: leave empty to auto-detect the frontend origin in GitHub Codespaces.
# Production requires an HTTPS origin, e.g. https://questoria.example.com.
WEB_ORIGIN=
NEXT_PUBLIC_SITE_URL=

# Local development uses console. Production requires Resend, an API key, and a verified sender.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Required in production (and when enabling admin TOTP locally): 32-byte hex key (64 characters).
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
