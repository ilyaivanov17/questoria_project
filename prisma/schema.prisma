generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum QuestRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum LevelProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum WalletCurrency {
  XP
  COIN
}

enum SkillMasteryStatus {
  PRACTICING
  DEVELOPING
  PROFICIENT
  MASTERED
}

enum LearningEvidenceType {
  INITIAL
  PRACTICE
  DELAYED_CHECK
  TRANSFER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  emailNormalized String     @unique @map("email_normalized")
  passwordHash    String     @map("password_hash")
  status             UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  mfaSecretEncrypted String? @map("mfa_secret_encrypted")
  mfaEnabledAt DateTime? @map("mfa_enabled_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  profile         Profile?
  roles           UserRole[]
  sessions        Session[]
  authoredVersions QuestVersion[] @relation("QuestVersionAuthor")
  reviewedVersions QuestVersion[] @relation("QuestVersionReviewer")
  approvedVersions QuestVersion[] @relation("QuestVersionApprover")
  publishedVersions QuestVersion[] @relation("QuestVersionPublisher")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  auditLogs AdminAuditLog[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model MfaRecoveryCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  codeHash  String   @unique @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("mfa_recovery_codes")
}

model Profile {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid @map("user_id")
  nickname       String?
  ageBand        String?          @map("age_band")
  locale         String           @default("ru")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  questRuns      QuestRun[]
  puzzleAttempts PuzzleAttempt[]
  walletEntries   WalletLedger[]
  completions     QuestCompletion[]
  skillProgress   ProfileSkillProgress[]
  learningEvidence LearningEvidence[]
  achievements      ProfileAchievement[]

  @@map("profiles")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  key       String     @unique
  name      String
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String
  locale      String        @default("ru")
  title       String
  description String
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0) @map("sort_order")
  quests      Quest[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([locale, slug])
  @@index([status, sortOrder])
  @@map("categories")
}

model Quest {
  id        String        @id @default(uuid()) @db.Uuid
  categoryId String       @db.Uuid @map("category_id")
  slug      String        @unique
  status    ContentStatus @default(DRAFT)
  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions  QuestVersion[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([categoryId, status])
  @@map("quests")
}

model QuestVersion {
  id          String             @id @default(uuid()) @db.Uuid
  questId     String             @db.Uuid @map("quest_id")
  versionNo   Int                @map("version_no")
  title       String
  summary     String
  objectives  Json
  ageMin      Int                @map("age_min")
  ageMax      Int                @map("age_max")
  difficulty  String
  durationMin Int                @map("duration_min")
  locale      String             @default("ru")
  seo         Json?
  status      QuestVersionStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  internalName String?           @map("internal_name")
  description String             @default("")
  skills String[]                @default([])
  coverUrl String?               @map("cover_url")
  coverAlt String?               @map("cover_alt")
  coverLicenseSource String?     @map("cover_license_source")
  authorId String?               @db.Uuid @map("author_id")
  reviewerId String?             @db.Uuid @map("reviewer_id")
  reviewFeedback String?             @map("review_feedback")
  approvedById String?           @db.Uuid @map("approved_by_id")
  publishedById String?          @db.Uuid @map("published_by_id")
  approvedAt DateTime?           @map("approved_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  author User?                   @relation("QuestVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer User?                 @relation("QuestVersionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  approvedBy User?               @relation("QuestVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  publishedBy User?              @relation("QuestVersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  quest       Quest              @relation(fields: [questId], references: [id], onDelete: Restrict)
  levels      Level[]
  runs        QuestRun[]
  completions QuestCompletion[]
  learningEvidence LearningEvidence[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([questId, versionNo])
  @@index([questId, status])
  @@map("quest_versions")
}

model Level {
  id             String      @id @default(uuid()) @db.Uuid
  questVersionId String      @db.Uuid @map("quest_version_id")
  orderNo        Int         @map("order_no")
  title          String
  intro          String
  questVersion   QuestVersion @relation(fields: [questVersionId], references: [id], onDelete: Restrict)
  puzzles        Puzzle[]
  progress       LevelProgress[]

  @@unique([questVersionId, orderNo])
  @@map("levels")
}

model Puzzle {
  id                String          @id @default(uuid()) @db.Uuid
  levelId           String          @db.Uuid @map("level_id")
  orderNo           Int             @map("order_no")
  type              String
  schemaVersion     Int             @default(1) @map("schema_version")
  publicPayload     Json            @map("public_payload")
  solutionPrivate   Json            @map("solution_private")
  maxAttempts       Int             @default(3) @map("max_attempts")
  maxScore          Int             @default(10) @map("max_score")
  level             Level           @relation(fields: [levelId], references: [id], onDelete: Restrict)
  hints             Hint[]
  attempts          PuzzleAttempt[]
  learningEvidence LearningEvidence[]

  @@unique([levelId, orderNo])
  @@map("puzzles")
}

model Hint {
  id       String @id @default(uuid()) @db.Uuid
  puzzleId String @db.Uuid @map("puzzle_id")
  orderNo  Int    @map("order_no")
  body     String
  puzzle   Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Restrict)

  @@unique([puzzleId, orderNo])
  @@map("hints")
}

model QuestRun {
  id             String         @id @default(uuid()) @db.Uuid
  profileId      String         @db.Uuid @map("profile_id")
  questVersionId String         @db.Uuid @map("quest_version_id")
  status          QuestRunStatus @default(IN_PROGRESS)
  startedAt       DateTime       @default(now()) @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  lastActivityAt  DateTime       @default(now()) @map("last_activity_at")
  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  questVersion    QuestVersion   @relation(fields: [questVersionId], references: [id], onDelete: Restrict)
  attempts        PuzzleAttempt[]
  levelProgress   LevelProgress[]
  completion      QuestCompletion?
  learningEvidence LearningEvidence[]

  @@index([profileId, status])
  @@index([questVersionId])
  @@map("quest_runs")
}

model PuzzleAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  profileId         String   @db.Uuid @map("profile_id")
  questRunId        String   @db.Uuid @map("quest_run_id")
  puzzleId          String   @db.Uuid @map("puzzle_id")
  attemptKey        String   @map("attempt_key")
  answer            Json
  isCorrect         Boolean  @map("is_correct")
  score             Int      @default(0)
  feedback          String
  attemptsRemaining Int      @map("attempts_remaining")
  xpAwarded         Int      @default(0) @map("xp_awarded")
  coinsAwarded      Int      @default(0) @map("coins_awarded")
  runCompleted      Boolean  @default(false) @map("run_completed")
  questFirstCompletion Boolean @default(false) @map("quest_first_completion")
  createdAt         DateTime @default(now()) @map("created_at")
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  questRun          QuestRun @relation(fields: [questRunId], references: [id], onDelete: Restrict)
  puzzle            Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Restrict)
  learningEvidence  LearningEvidence[]

  @@unique([profileId, attemptKey])
  @@index([questRunId, puzzleId, createdAt])
  @@map("puzzle_attempts")
}

model LevelProgress {
  id          String              @id @default(uuid()) @db.Uuid
  questRunId  String              @db.Uuid @map("quest_run_id")
  levelId     String              @db.Uuid @map("level_id")
  status      LevelProgressStatus @default(COMPLETED)
  score       Int                 @default(0)
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @default(now()) @map("completed_at")
  questRun    QuestRun            @relation(fields: [questRunId], references: [id], onDelete: Restrict)
  level       Level               @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@unique([questRunId, levelId])
  @@index([levelId, status])
  @@map("level_progress")
}

model QuestCompletion {
  id             String       @id @default(uuid()) @db.Uuid
  profileId      String       @db.Uuid @map("profile_id")
  questVersionId String       @db.Uuid @map("quest_version_id")
  questRunId     String       @unique @db.Uuid @map("quest_run_id")
  score          Int          @default(0)
  xpAwarded      Int          @default(0) @map("xp_awarded")
  coinsAwarded   Int          @default(0) @map("coins_awarded")
  completedAt    DateTime     @default(now()) @map("completed_at")
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Restrict)
  questVersion   QuestVersion @relation(fields: [questVersionId], references: [id], onDelete: Restrict)
  questRun       QuestRun     @relation(fields: [questRunId], references: [id], onDelete: Restrict)

  @@unique([profileId, questVersionId])
  @@index([profileId, completedAt])
  @@map("quest_completions")
}

model WalletLedger {
  id             String        @id @default(uuid()) @db.Uuid
  profileId      String        @db.Uuid @map("profile_id")
  currency       WalletCurrency
  amount         Int
  reason         String
  sourceType     String        @map("source_type")
  sourceId       String        @map("source_id")
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@index([sourceType, sourceId])
  @@map("wallet_ledger")
}

model Skill {
  id          String                  @id @default(uuid()) @db.Uuid
  key         String                  @unique
  name        String
  description String?
  difficulty  String?
  createdAt   DateTime                @default(now()) @map("created_at")
  progress    ProfileSkillProgress[]
  evidence    LearningEvidence[]
  prerequisites SkillPrerequisite[]   @relation("SkillPrerequisiteChild")
  unlocks       SkillPrerequisite[]   @relation("SkillPrerequisiteParent")

  @@index([name])
  @@index([difficulty])
  @@map("skills")
}

model SkillPrerequisite {
  skillId        String @db.Uuid @map("skill_id")
  prerequisiteId String @db.Uuid @map("prerequisite_id")
  skill          Skill  @relation("SkillPrerequisiteChild", fields: [skillId], references: [id], onDelete: Restrict)
  prerequisite   Skill  @relation("SkillPrerequisiteParent", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@id([skillId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("skill_prerequisites")
}

model ProfileSkillProgress {
  id                    String             @id @default(uuid()) @db.Uuid
  profileId             String             @db.Uuid @map("profile_id")
  skillId               String             @db.Uuid @map("skill_id")
  status                SkillMasteryStatus @default(PRACTICING)
  attemptsCount         Int                @default(0) @map("attempts_count")
  successfulAttempts    Int                @default(0) @map("successful_attempts")
  distinctPuzzles       Int                @default(0) @map("distinct_puzzles")
  distinctQuestVersions Int                @default(0) @map("distinct_quest_versions")
  distinctQuests        Int                @default(0) @map("distinct_quests")
  distinctRuns          Int                @default(0) @map("distinct_runs")
  distinctTaskTypes     Int                @default(0) @map("distinct_task_types")
  firstPracticedAt      DateTime           @default(now()) @map("first_practiced_at")
  lastPracticedAt       DateTime           @default(now()) @map("last_practiced_at")
  masteredAt            DateTime?          @map("mastered_at")
  profile               Profile            @relation(fields: [profileId], references: [id], onDelete: Restrict)
  skill                 Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([profileId, skillId])
  @@index([profileId, status])
  @@map("profile_skill_progress")
}

model LearningEvidence {
  id              String               @id @default(uuid()) @db.Uuid
  profileId       String               @db.Uuid @map("profile_id")
  skillId         String               @db.Uuid @map("skill_id")
  questRunId      String               @db.Uuid @map("quest_run_id")
  questVersionId  String               @db.Uuid @map("quest_version_id")
  puzzleId        String               @db.Uuid @map("puzzle_id")
  puzzleAttemptId String               @db.Uuid @map("puzzle_attempt_id")
  isCorrect       Boolean              @map("is_correct")
  score           Int                  @default(0)
  taskType        String               @map("task_type")
  evidenceType    LearningEvidenceType @default(INITIAL) @map("evidence_type")
  occurredAt      DateTime             @default(now()) @map("occurred_at")
  profile         Profile              @relation(fields: [profileId], references: [id], onDelete: Restrict)
  skill           Skill                @relation(fields: [skillId], references: [id], onDelete: Restrict)
  questRun        QuestRun             @relation(fields: [questRunId], references: [id], onDelete: Restrict)
  questVersion    QuestVersion         @relation(fields: [questVersionId], references: [id], onDelete: Restrict)
  puzzle          Puzzle               @relation(fields: [puzzleId], references: [id], onDelete: Restrict)
  puzzleAttempt   PuzzleAttempt        @relation(fields: [puzzleAttemptId], references: [id], onDelete: Restrict)

  @@unique([puzzleAttemptId, skillId])
  @@index([profileId, skillId, occurredAt])
  @@index([skillId, questVersionId])
  @@map("learning_evidence")
}

model Achievement {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique
  title        String
  description  String
  icon         String
  xpReward     Int                  @default(0) @map("xp_reward")
  coinsReward  Int                  @default(0) @map("coins_reward")
  sortOrder    Int                  @default(0) @map("sort_order")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  profileAwards ProfileAchievement[]

  @@index([active, sortOrder])
  @@map("achievements")
}

model ProfileAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  profileId     String      @db.Uuid @map("profile_id")
  achievementId String      @db.Uuid @map("achievement_id")
  xpAwarded     Int         @default(0) @map("xp_awarded")
  coinsAwarded  Int         @default(0) @map("coins_awarded")
  awardedAt     DateTime    @default(now()) @map("awarded_at")
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Restrict)
  achievement  Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([profileId, achievementId])
  @@index([profileId, awardedAt])
  @@map("profile_achievements")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}
